    },

    "targets": [
      {
        "id": "introduce_name",
        "order": 1,
        "goal": "Learner introduces their name.",
        "patterns": ["Ich heiße {name}"],
        "suggestion": "Ich heiße {name}"
      },
      {
        "id": "ask_name",
        "order": 2,
        "goal": "Learner asks someone's name.",
        "patterns": ["Wie heißt du?"],
        "suggestion": "Wie heißt du?"
      },
      {
        "id": "describe_male",
        "order": 3,
        "goal": "Learner talks about a male person.",
        "patterns": ["Er heißt {name}", "Er wohnt in {city}"],
        "suggestion": "Er heißt Thomas."
      },
      {
        "id": "describe_female",
        "order": 4,
        "goal": "Learner talks about a female person.",
        "patterns": ["Sie heißt {name}", "Sie wohnt in {city}"],
        "suggestion": "Sie heißt Sarah."
      },
      {
        "id": "say_where_live",
        "order": 5,
        "goal": "Learner says where they live.",
        "patterns": ["Ich wohne in {city}"],
        "suggestion": "Ich wohne in {city}"
      },
      {
        "id": "ask_where",
        "order": 6,
        "goal": "Learner asks where someone lives.",
        "patterns": ["Wo wohnt er?", "Wo wohnt sie?"],
        "suggestion": "Wo wohnt er?"
      }
    ],

    "behavior": {
      "lead": true,
      "strict_order": true,
      "natural_wording": true,
      "no_grammar_lecture": true,
      "short_corrections": true,
