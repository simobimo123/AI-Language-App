    {"id":"q01","order":1,"type":"multiple_choice","correct_answer":"اسمي محمد.","translations":{"ar":{"question":"ماذا تعني: Ich heiße Mohammed؟","options":["اسمي محمد.","أين يسكن محمد؟","ما اسمك؟","هو محمد."],"explanation":"Ich heiße تعني اسمي."}}},
    {"id":"q02","order":2,"type":"multiple_choice","correct_answer":"Wie heißt du?","translations":{"ar":{"question":"كيف تقول: ما اسمك؟","options":["Wie heißt du?","Ich heiße du.","Wo wohnst du?","Er heißt du."],"explanation":"Wie heißt du? هو السؤال عن الاسم."}}},
    {"id":"q03","order":3,"type":"multiple_choice","correct_answer":"Er heißt Thomas.","translations":{"ar":{"question":"أي جملة تعني: اسمه توماس؟","options":["Er heißt Thomas.","Sie heißt Thomas.","Ich heiße Thomas.","Wie heißt Thomas?"],"explanation":"Er = هو."}}},
    {"id":"q04","order":4,"type":"multiple_choice","correct_answer":"Sie heißt Sarah.","translations":{"ar":{"question":"اختر الجملة الصحيحة لمعنى: اسمها سارة.","options":["Sie heißt Sarah.","Er heißt Sarah.","Ich heiße Sarah.","Wo heißt Sarah?"],"explanation":"Sie = هي في هذا السياق."}}},
    {"id":"q05","order":5,"type":"multiple_choice","correct_answer":"Ich wohne in Fès.","translations":{"ar":{"question":"كيف تقول: أنا أسكن في فاس؟","options":["Ich wohne in Fès.","Ich heiße Fès.","Wo wohnt Fès?","Sie wohnt Fès."],"explanation":"Ich wohne in ... تعني أنا أسكن في ..."}}},
    {"id":"q06","order":6,"type":"short_answer","correct_answer":"Wo wohnt er?","accepted_answers":["Wo wohnt er?","wo wohnt er?"],"translations":{"ar":{"question":"اكتب بالألمانية: أين يسكن؟","options":[],"explanation":"Wo wohnt er?"}}},
    {"id":"r01","order":7,"type":"multiple_choice","correct_answer":"Wie heißt du?","translations":{"ar":{"question":"قابلت شخصًا جديدًا وتريد أن تسأله عن اسمه. ماذا تقول؟","options":["Wie heißt du?","Wo wohnt er?","Ich wohne in Fès.","Sie heißt Sarah."],"explanation":"نسترجع سؤال الاسم ونستخدمه في موقف جديد."}}},
    {"id":"r02","order":8,"type":"multiple_choice","correct_answer":"Er wohnt in Berlin.","translations":{"ar":{"question":"توماس يسكن في برلين. أي جملة تصف ذلك؟","options":["Er wohnt in Berlin.","Sie wohnt in Berlin.","Ich wohne in Berlin.","Wie heißt Thomas?"],"explanation":"هنا نتحدث عن رجل، لذلك نستخدم Er مع wohnt."}}},
    {"id":"r03","order":9,"type":"multiple_choice","correct_answer":"Sie heißt Sarah.","translations":{"ar":{"question":"أنت تتحدث عن Sarah. كيف تقول إن اسمها Sarah؟","options":["Sie heißt Sarah.","Er heißt Sarah.","Ich heiße Sarah.","Wie heißt sie Sarah?"],"explanation":"عند الحديث عن Sarah نستخدم Sie في هذا الدرس."}}},
    {"id":"r04","order":10,"type":"short_answer","correct_answer":"Ich wohne in Fès.","accepted_answers":["Ich wohne in Fès.","ich wohne in fès.","Ich wohne in Fes.","ich wohne in fes."],"translations":{"ar":{"question":"تخيل أن شخصًا يسألك أين تسكن. اكتب بالألمانية: أنا أسكن في فاس.","options":[],"explanation":"استخدم Ich wohne in ... للتعبير عن مكان سكنك."}}},
    {"id":"r05","order":11,"type":"multiple_choice","correct_answer":"Ich heiße Ali.","translations":{"ar":{"question":"شخص جديد اسمه علي. كيف يقدم نفسه؟","options":["Ich heiße Ali.","Er heißt Ali.","Wie heißt du Ali?","Ich wohne Ali."],"explanation":"عند تقديم نفسك نستخدم Ich heiße مع الاسم."}}},
    {"id":"r06","order":12,"type":"multiple_choice","correct_answer":"Wo wohnt sie?","translations":{"ar":{"question":"تريد أن تعرف مكان سكن سارة. ما السؤال المناسب؟","options":["Wo wohnt sie?","Wie heißt sie?","Ich wohne in Sarah.","Er wohnt sie?"],"explanation":"نتحدث عن Sarah، لذلك نستخدم sie مع wohnt."}}},
    {"id":"r07","order":13,"type":"multiple_choice","correct_answer":"Sie wohnt in Köln.","translations":{"ar":{"question":"سارة تسكن في كولونيا. أي جملة صحيحة؟","options":["Sie wohnt in Köln.","Er wohnt in Köln.","Ich wohne in Köln.","Sie heißt in Köln."],"explanation":"Sie تُستخدم للحديث عن سارة، وwohnt للتعبير عن السكن."}}},
    {"id":"r08","order":14,"type":"multiple_choice","correct_answer":"Er heißt Omar.","translations":{"ar":{"question":"تتحدث عن رجل اسمه عمر. أي جملة صحيحة؟","options":["Er heißt Omar.","Sie heißt Omar.","Ich heiße Omar.","Er wohnt Omar."],"explanation":"عند الحديث عن رجل نستخدم Er."}}},
    {"id":"r09","order":15,"type":"short_answer","correct_answer":"Wie heißt du?","accepted_answers":["Wie heißt du?","wie heißt du?","Wie heisst du?","wie heisst du?"],"translations":{"ar":{"question":"تخيل أنك في لقاء جديد وتريد معرفة اسم الشخص أمامك. اكتب السؤال بالألمانية.","options":[],"explanation":"استرجع سؤال الاسم الذي تعلمته."}}},
    {"id":"r10","order":16,"type":"short_answer","correct_answer":"Wo wohnt sie?","accepted_answers":["Wo wohnt sie?","wo wohnt sie?"],"translations":{"ar":{"question":"أنت تتحدث عن فتاة وتريد أن تعرف أين تسكن. اكتب السؤال بالألمانية.","options":[],"explanation":"استخدم Wo مع wohnt، وللفتاة نستخدم sie."}}}
