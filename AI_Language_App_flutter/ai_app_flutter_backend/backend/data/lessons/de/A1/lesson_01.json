  "level": "A1",
  "unit": 1,
  "order": 1,
  "title": "Ich und du",
  "objective": "Introduce yourself, ask about another person's name and place of residence, and talk about other people and groups.",

  "vocabulary": [
    ["ich", "I"],
    ["du", "you"],
    ["er", "he"],
    ["sie", "she/they"],
    ["wir", "we"],
    ["ihr", "you plural"],
    ["heißen", "to be called"],
    ["wohnen", "to live"],
    ["wie", "how/what"],
    ["wo", "where"]
  ],

  "conversation": {
    "mode": "guided_natural_conversation",

    "path": [
      {
        "id": "p1",
        "role": "assistant",
        "target": "Hallo! Ich heiße ...",
        "context": "The tutor introduces themselves naturally."
      },
      {
        "id": "p2",
        "role": "assistant",
        "target": "Wie heißt du?",
        "context": "Ask the learner for their name."
      },
      {
        "id": "p3",
        "role": "learner",
        "target": "Ich heiße ...",
        "context": "Elicit the learner's own name."
      },
      {
        "id": "p4",
        "role": "assistant",
        "target": "Wo wohnst du?",
        "context": "Ask where the learner lives."
      },
      {
        "id": "p5",
        "role": "learner",
        "target": "Ich wohne in ...",
        "context": "Elicit the learner's place of residence."
      },
      {
        "id": "p6",
        "role": "assistant",
        "target": "Er heißt ...",
        "context": "Introduce a male third person naturally."
      },
      {
        "id": "p7",
        "role": "learner",
        "target": "Er heißt ...",
        "context": "Elicit a sentence about a male third person."
      },
      {
        "id": "p8",
        "role": "assistant",
        "target": "Sie heißt ...",
        "context": "Introduce a female third person naturally."
      },
      {
        "id": "p9",
        "role": "learner",
        "target": "Sie heißt ...",
        "context": "Elicit a sentence about a female third person."
      },
      {
        "id": "p10",
        "role": "assistant",
        "target": "Wo wohnt ihr?",
        "context": "Ask where a group lives."
      },
      {
        "id": "p11",
        "role": "learner",
        "target": "Wir wohnen in ...",
        "context": "Elicit a statement about where the learner and their group live."
      },
      {
        "id": "p12",
        "role": "learner",
        "target": "Ihr wohnt ...",
        "context": "Elicit a statement using ihr about where other people live."
      },
      {
        "id": "p13",
        "role": "learner",
        "target": "Sie wohnen in ...",
        "context": "Elicit a statement about where a group of other people lives."
      }
    ]
  },

