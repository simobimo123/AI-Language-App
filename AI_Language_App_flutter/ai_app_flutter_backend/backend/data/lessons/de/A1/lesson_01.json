    },

    "completion": {
      "condition": "all_targets_completed",
      "closing": {
        "instruction": "After the final required target is demonstrated, give exactly ONE short natural closing sentence. Do not ask a question, introduce a new topic, continue the conversation, or produce multiple goodbye phrases. A single goodbye such as 'Sehr gut! Bis zum nächsten Mal!' is enough.",
