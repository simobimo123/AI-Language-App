{
  "language": "de",
  "level": "A1",
  "targets": [
    {
      "order": 1,
      "id": "introduce_name",
      "goal": "The learner can say their own name.",
      "patterns": [
        "Ich heiße + Name"
      ]
    },
    {
      "order": 2,
      "id": "ask_name",
      "goal": "The learner can ask another person for their name.",
      "patterns": [
        "Wie heißt du?"
      ]
    },
    {
      "order": 3,
      "id": "describe_male",
      "goal": "The learner can say a male person's name or where he lives.",
      "patterns": [
        "Er heißt + Name",
        "Er wohnt in + Ort"
      ]
    },
    {
      "order": 4,
      "id": "describe_female",
      "goal": "The learner can say a female person's name or where she lives.",
      "patterns": [
        "Sie heißt + Name",
        "Sie wohnt in + Ort"
      ]
    },
    {
      "order": 5,
      "id": "say_where_live",
      "goal": "The learner can say where they live.",
      "patterns": [
        "Ich wohne in + Ort"
      ]
    },
    {
      "order": 6,
      "id": "ask_where",
      "goal": "The learner can ask where another person lives.",
      "patterns": [
        "Wo wohnt er?",
        "Wo wohnt sie?"
      ]
    }
  ],
  "behavior": {
    "strict_order": true,
    "one_question_at_a_time": true,
    "short_corrections": true,
    "no_grammar_lecture": true,
    "accept_correct_alternatives": true
  }
}