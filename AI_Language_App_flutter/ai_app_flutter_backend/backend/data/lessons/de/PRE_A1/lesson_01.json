  "sections": [
    {
      "id": "de_pre_a1_l01_s01",
      "order": 1,
      "type": "explanation",
      "content": {
        "target_text": "a – e – i – o – u",
        "pronunciation": "a – e – i – o – u"
      },
      "translations": {
        "ar": {
          "translation": "حروف العلة الأساسية: a و e و i و o و u",
          "pronunciation": "آ / إِ-أَيْ / إي / أو / أوو",
          "explanation": "سنبدأ بأصوات بسيطة جدًا. لا نحتاج إلى دراسة القواعد الآن؛ الهدف هو التعرف على شكل الحرف وصوته داخل الكلمة."
        },
        "en": {
          "translation": "The basic vowels: a, e, i, o and u.",
          "pronunciation": "a / e / i / o / u",
          "explanation": "We begin with very simple sounds. We do not need grammar yet; the goal is to recognize the letter shape and its sound inside a word."
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s02",
      "order": 2,
      "type": "reading_pattern",
      "content": {
        "target_text": "sch",
        "pronunciation": "sch"
      },
      "translations": {
        "ar": {
          "translation": "صوت قريب من «ش»",
          "pronunciation": "ش",
          "explanation": "عندما نرى sch في الألمانية يكون الصوت عادة قريبًا من «ش».",
          "examples": [
            {
              "target_text": "Schule",
              "translation": "مدرسة",
              "pronunciation": "شوله"
            }
          ]
        },
        "en": {
          "translation": "A sound similar to English \"sh\".",
          "pronunciation": "sh",
          "explanation": "In German, sch is usually pronounced with a sound similar to \"sh\".",
          "examples": [
            {
              "target_text": "Schule",
              "translation": "school",
              "pronunciation": "shoo-luh"
            }
          ]
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s03",
      "order": 3,
      "type": "reading_pattern",
      "content": {
        "target_text": "ei",
        "pronunciation": "ei"
      },
      "translations": {
        "ar": {
          "translation": "نمط صوتي شائع",
          "pronunciation": "آي",
          "explanation": "النمط ei يُنطق تقريبًا مثل «آي» في كلمات ألمانية كثيرة.",
          "examples": [
            {
              "target_text": "mein",
              "translation": "لي / خاصتي",
              "pronunciation": "ماين"
            }
          ]
        },
        "en": {
          "translation": "A common German sound pattern.",
          "pronunciation": "eye",
          "explanation": "The pattern ei is commonly pronounced like \"eye\".",
          "examples": [
            {
              "target_text": "mein",
              "translation": "my",
              "pronunciation": "mine"
            }
          ]
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s04",
      "order": 4,
      "type": "reading_pattern",
      "content": {
        "target_text": "ie",
        "pronunciation": "ie"
      },
      "translations": {
        "ar": {
          "translation": "نمط صوتي شائع",
          "pronunciation": "إي طويلة",
          "explanation": "النمط ie يعطي غالبًا صوتًا طويلًا قريبًا من «إي».",
          "examples": [
            {
              "target_text": "wie",
              "translation": "كيف",
              "pronunciation": "في"
            }
          ]
        },
        "en": {
          "translation": "A common German sound pattern.",
          "pronunciation": "long ee",
          "explanation": "The pattern ie usually produces a long \"ee\" sound.",
          "examples": [
            {
              "target_text": "wie",
              "translation": "how",
              "pronunciation": "vee"
            }
          ]
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s05",
      "order": 5,
      "type": "reading_pattern",
      "content": {
        "target_text": "eu",
        "pronunciation": "eu"
      },
      "translations": {
        "ar": {
          "translation": "نمط صوتي شائع",
          "pronunciation": "أُوي تقريبًا",
          "explanation": "النمط eu يُنطق تقريبًا مثل «أُوي».",
          "examples": [
            {
              "target_text": "neu",
              "translation": "جديد",
              "pronunciation": "نوي"
            }
          ]
        },
        "en": {
          "translation": "A common German sound pattern.",
          "pronunciation": "oy",
          "explanation": "The pattern eu is pronounced approximately like \"oy\".",
          "examples": [
            {
              "target_text": "neu",
              "translation": "new",
              "pronunciation": "noy"
            }
          ]
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s06",
      "order": 6,
      "type": "reading_pattern",
      "content": {
        "target_text": "ch",
        "pronunciation": "ch"
      },
      "translations": {
        "ar": {
          "translation": "صوت خاص في الألمانية",
          "pronunciation": "صوت خفيف يختلف حسب الكلمة",
          "explanation": "الحرفان ch لهما نطق خاص في الألمانية. في هذه المرحلة يكفي التعرف عليهما في كلمة ich دون دراسة كل قواعد النطق.",
          "examples": [
            {
              "target_text": "ich",
              "translation": "أنا",
              "pronunciation": "إِخ تقريبًا"
            }
          ]
        },
        "en": {
          "translation": "A special German sound.",
          "pronunciation": "a German ch sound",
          "explanation": "The letters ch have a special pronunciation in German. At this stage, it is enough to recognize them in ich without learning all pronunciation rules.",
          "examples": [
            {
              "target_text": "ich",
              "translation": "I",
              "pronunciation": "ikh, approximately"
            }
          ]
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s07",
      "order": 7,
      "type": "special_characters",
      "content": {
        "target_text": "ä – ö – ü – ß",
        "pronunciation": "ä – ö – ü – ß"
      },
      "translations": {
        "ar": {
          "translation": "أحرف ورمز خاصان بالألمانية",
          "pronunciation": "ä و ö و ü أصوات خاصة، و ß يشبه ss في النطق في كلمات كثيرة",
          "explanation": "سنرى هذه الرموز كثيرًا في الألمانية. لا نحتاج إلى حفظ قواعدها كاملة في هذا الدرس؛ المطلوب فقط التعرف على شكلها."
        },
        "en": {
          "translation": "Special German letters and symbol.",
          "pronunciation": "special vowel sounds; ß is often similar to ss",
          "explanation": "You will see these symbols often in German. We do not need to learn all their rules yet; for now, simply recognize their shapes."
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s08",
      "order": 8,
      "type": "reading_sequence",
      "content": {
        "target_text": "Ma-ma → Mama",
        "pronunciation": "Mama"
      },
      "translations": {
        "ar": {
          "translation": "ماما",
          "pronunciation": "ماما",
          "explanation": "نقسم الكلمة إلى مقاطع بسيطة ثم نقرأ الكلمة كاملة."
        },
        "en": {
          "translation": "Mom / Mum",
          "pronunciation": "mama",
          "explanation": "We divide the word into simple parts and then read the whole word."
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s09",
      "order": 9,
      "type": "reading_sequence",
      "content": {
        "target_text": "Pa-pa → Papa",
        "pronunciation": "Papa"
      },
      "translations": {
        "ar": {
          "translation": "بابا / الأب",
          "pronunciation": "بابا",
          "explanation": "الكلمة قصيرة ويمكن قراءتها مباشرة من المقاطع البسيطة."
        },
        "en": {
          "translation": "Dad / Father",
          "pronunciation": "papa",
          "explanation": "The word is short and can be read directly from its simple parts."
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s10",
      "order": 10,
      "type": "reading_sequence",
      "content": {
        "target_text": "O-ma → Oma",
        "pronunciation": "Oma"
      },
      "translations": {
        "ar": {
          "translation": "الجدة",
          "pronunciation": "أوما",
          "explanation": "هذه من الكلمات الأولى السهلة للقراءة."
        },
        "en": {
          "translation": "Grandma / Grandmother",
          "pronunciation": "oh-ma",
          "explanation": "This is one of the first easy words to read."
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s11",
      "order": 11,
      "type": "reading_sequence",
      "content": {
        "target_text": "O-pa → Opa",
        "pronunciation": "Opa"
      },
      "translations": {
        "ar": {
          "translation": "الجد",
          "pronunciation": "أوبا",
          "explanation": "نقرأ الكلمة من مقطعين بسيطين."
        },
        "en": {
          "translation": "Grandpa / Grandfather",
          "pronunciation": "oh-pa",
          "explanation": "We read the word from two simple parts."
        }
      }
    },

    {
      "id": "de_pre_a1_l01_s12",
      "order": 12,
      "type": "micro_review",
      "content": {
        "target_text": "Hallo! Mama. Papa. Mein Name.",
        "pronunciation": "Hallo! Mama. Papa. Mein Name."
      },
      "translations": {
        "ar": {
          "translation": "مرحبًا! ماما. بابا. اسمي / اسمي هو...",
          "pronunciation": "هالو! ماما. بابا. ماين نامه.",
          "explanation": "هذه أمثلة قصيرة جدًا. بعض الكلمات هنا تظهر كأمثلة للقراءة فقط، وسيتم تقديمها كمفردات جديدة في الدروس المناسبة لاحقًا."
        },
        "en": {
          "translation": "Hello! Mom. Dad. My name.",
          "pronunciation": "Hello! Mama. Papa. Mine nah-muh.",
          "explanation": "These are very short examples. Some words are shown only as reading examples and will be introduced as new vocabulary in appropriate later lessons."
        }
      }
    }
  ],

