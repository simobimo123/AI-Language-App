      "order": 1,
      "type": "multiple_choice",
      "translations": {
        "ar": {
          "question": "أي مجموعة حروف تعطي صوتًا قريبًا من «ش»؟",
          "options": [
            {"id": "a", "text": "sch"},
            {"id": "b", "text": "ei"},
            {"id": "c", "text": "ie"}
          ],
          "explanation": "النمط sch يُنطق عادة بصوت قريب من «ش»."
        },
        "en": {
          "question": "Which letter group produces a sound similar to \"sh\"?",
