  "metadata": {
    "title": "الأصوات والقراءة الأولى",
    "title_target": "Laute und erstes Lesen",
    "objective": "التعرف على أهم أصوات وأنماط القراءة الألمانية وقراءة كلمات ألمانية قصيرة جدًا.",
    "estimated_minutes": 15,
    "difficulty": "PRE_A1"
  },
  "sections": [
    {
      "id": "de_pre_a1_l01_s01",
      "order": 1,
      "type": "explanation",
      "content": {
        "target_text": "a – e – i – o – u",
        "translation": "حروف العلة الأساسية: a و e و i و o و u",
        "pronunciation": "آ / إِ-أَيْ / إي / أو / أوو",
        "explanation": "سنبدأ بأصوات بسيطة جدًا. لا نحتاج إلى دراسة القواعد الآن؛ الهدف هو التعرف على شكل الحرف وصوته داخل الكلمة."
      }
    },
    {
      "id": "de_pre_a1_l01_s02",
      "order": 2,
      "type": "reading_pattern",
      "content": {
        "target_text": "sch",
        "translation": "صوت قريب من «ش»",
        "pronunciation": "ش",
        "examples": [
          {
            "target_text": "Schule",
            "translation": "مدرسة",
            "pronunciation": "شوله"
          }
        ],
        "explanation": "عندما نرى sch في الألمانية يكون الصوت عادة قريبًا من «ش»."
      }
    },
    {
      "id": "de_pre_a1_l01_s03",
      "order": 3,
      "type": "reading_pattern",
      "content": {
        "target_text": "ei",
        "translation": "نمط صوتي شائع",
        "pronunciation": "آي",
        "examples": [
          {
            "target_text": "mein",
            "translation": "لي / خاصتي",
            "pronunciation": "ماين"
          }
        ],
        "explanation": "النمط ei يُنطق تقريبًا مثل «آي» في كلمات ألمانية كثيرة."
      }
    },
    {
      "id": "de_pre_a1_l01_s04",
      "order": 4,
      "type": "reading_pattern",
      "content": {
        "target_text": "ie",
        "translation": "نمط صوتي شائع",
        "pronunciation": "إي طويلة",
        "examples": [
          {
            "target_text": "wie",
            "translation": "كيف",
            "pronunciation": "في"
          }
        ],
        "explanation": "النمط ie يعطي غالبًا صوتًا طويلًا قريبًا من «إي»."
      }
    },
    {
      "id": "de_pre_a1_l01_s05",
      "order": 5,
      "type": "reading_pattern",
      "content": {
        "target_text": "eu",
        "translation": "نمط صوتي شائع",
        "pronunciation": "أُوي تقريبًا",
        "examples": [
          {
            "target_text": "neu",
            "translation": "جديد",
            "pronunciation": "نوي"
          }
        ],
        "explanation": "النمط eu يُنطق تقريبًا مثل «أُوي»."
      }
    },
    {
      "id": "de_pre_a1_l01_s06",
      "order": 6,
      "type": "reading_pattern",
      "content": {
        "target_text": "ch",
        "translation": "صوت خاص في الألمانية",
        "pronunciation": "صوت خفيف يختلف حسب الكلمة",
        "examples": [
          {
            "target_text": "ich",
            "translation": "أنا",
            "pronunciation": "إِخ تقريبًا"
          }
        ],
        "explanation": "الحرفان ch لهما نطق خاص في الألمانية. في هذه المرحلة يكفي التعرف عليهما في كلمة ich دون دراسة كل قواعد النطق."
      }
    },
    {
      "id": "de_pre_a1_l01_s07",
      "order": 7,
      "type": "special_characters",
      "content": {
        "target_text": "ä – ö – ü – ß",
        "translation": "أحرف ورمز خاصان بالألمانية",
        "pronunciation": "ä و ö و ü أصوات خاصة، و ß يشبه ss في النطق في كلمات كثيرة",
        "explanation": "سنرى هذه الرموز كثيرًا في الألمانية. لا نحتاج إلى حفظ قواعدها كاملة في هذا الدرس؛ المطلوب فقط التعرف على شكلها."
      }
    },
    {
      "id": "de_pre_a1_l01_s08",
      "order": 8,
      "type": "reading_sequence",
      "content": {
        "target_text": "Ma-ma → Mama",
        "translation": "ماما",
        "pronunciation": "ماما",
        "explanation": "نقسم الكلمة إلى مقاطع بسيطة ثم نقرأ الكلمة كاملة."
      }
    },
    {
      "id": "de_pre_a1_l01_s09",
      "order": 9,
      "type": "reading_sequence",
      "content": {
        "target_text": "Pa-pa → Papa",
        "translation": "بابا / الأب",
        "pronunciation": "بابا",
        "explanation": "الكلمة قصيرة ويمكن قراءتها مباشرة من المقاطع."
      }
    },
    {
      "id": "de_pre_a1_l01_s10",
      "order": 10,
      "type": "reading_sequence",
      "content": {
        "target_text": "O-ma → Oma",
        "translation": "الجدة",
        "pronunciation": "أوما",
        "explanation": "هذه من الكلمات الأولى السهلة للقراءة."
      }
    },
    {
      "id": "de_pre_a1_l01_s11",
      "order": 11,
      "type": "reading_sequence",
      "content": {
        "target_text": "O-pa → Opa",
        "translation": "الجد",
        "pronunciation": "أوبا",
        "explanation": "نقرأ الكلمة من مقطعين بسيطين."
      }
    },
    {
      "id": "de_pre_a1_l01_s12",
      "order": 12,
      "type": "micro_review",
      "content": {
        "target_text": "Hallo! Mama. Papa. Mein Name.",
        "translation": "مرحبًا! ماما. بابا. اسمي / اسمي هو...",
        "pronunciation": "هالو! ماما. بابا. ماين نامه.",
        "explanation": "هذه أمثلة قصيرة جدًا. بعض الكلمات هنا تظهر كأمثلة للقراءة فقط، وسيتم تقديمها كمفردات جديدة في الدروس المناسبة لاحقًا."
      }
    }
  ],
